# 宿主机 Laravel 连接 compose 中间件的变量模板（方案 A：编排内自建 MySQL）
# 用法：把需要的行合并进 .env 后执行 php artisan config:clear

APP_URL=http://mes.test

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=13307
DB_DATABASE=mes
DB_USERNAME=mes
DB_PASSWORD=mes_secret

# 仅 compose 内 MySQL 的 root 账号使用
MYSQL_ROOT_PASSWORD=root_secret

REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

MQTT_HOST=127.0.0.1
MQTT_PORT=11883
MQTT_FACTORY=F001

# 方案 B：复用宿主机已有 MySQL，仅改这三行即可（compose 内 mysql 服务可不启动）
# DB_HOST=127.0.0.1
# DB_PORT=13306
# DB_DATABASE=mes
